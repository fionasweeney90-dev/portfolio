---
// Small stroke arrows used in links and cards.
interface Props {
  name: 'arrow-up-right' | 'arrow-left' | 'arrow-right';
  size?: number;
}

const { name, size = 14 } = Astro.props;
const paths = {
  'arrow-up-right': 'M4.5 11.5L11.5 4.5M5.5 4.5h6v6',
  'arrow-left': 'M13 8H3M7.5 3.5L3 8l4.5 4.5',
  'arrow-right': 'M3 8h10M8.5 3.5L13 8l-4.5 4.5',
};
---
<svg width={size} height={size} viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={paths[name]}></path></svg>

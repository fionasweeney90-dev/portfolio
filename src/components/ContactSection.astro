---
import Icon from './Icon.astro';
import { contact } from '../lib/site';

const year = new Date().getFullYear();
---
<section id="contact" class="contact">
  <h2 class="eyebrow">LET’S HAVE A CHAT!</h2>
  <h3 class="title">Got something complicated?<br />Let’s make it <span class="hl-hover word">simple.</span></h3>
  <p class="body-text intro">Have a project, an opportunity or just fancy a chat about design? I’d love to hear from you.</p>
  <div class="footer">
    <div class="links">
      <a class="cl cl-primary" href={`mailto:${contact.email}`}>Email Fiona<Icon name="arrow-up-right" /></a>
      <a class="cl" href={contact.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a class="cl" href={contact.strava} target="_blank" rel="noopener noreferrer">Strava</a>
    </div>
    <span>© {year} Fiona Sweeney</span>
  </div>
</section>

<style>
  .contact {
    border-top: 1px solid var(--rule);
    padding: 20px 0 clamp(16px, 2vw, 28px);
  }
  .eyebrow {
    margin-bottom: clamp(20px, 2.5vw, 32px);
  }
  .title {
    margin: 0;
    font-size: clamp(30px, 3.4vw, 48px);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.03em;
    color: var(--ink);
  }
  .word {
    display: inline-block;
    margin-top: 0.12em;
    padding: 0.146em 0.25em;
    border-radius: 0.167em;
    color: var(--ink);
    white-space: nowrap;
  }
  .intro {
    margin: 24px 0 0;
    max-width: 750px;
  }
  .footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 16px;
    margin-top: clamp(48px, 7vw, 96px);
    font-size: 15px;
    color: #5f5f5f;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 24px;
  }
</style>

---
import { url } from '../lib/site';

interface Props {
  // On the home page links jump within the page; elsewhere they go back to it.
  home?: boolean;
}

const { home = false } = Astro.props;
const to = (hash: string) => (home ? hash : url('/') + hash);
---
<nav class="nav">
  <div>
    <a class="nv brand" href={home ? '#top' : url('/')}>Fiona Sweeney</a>
    <p class="role">Lead Product Designer</p>
  </div>
  <div class="links">
    <a class="nv pill" href={to('#work')} style="--pill: var(--pink)"><span>Work</span></a>
    <a class="nv pill" href={to('#about')} style="--pill: var(--blue)"><span>About</span></a>
    <a class="nv pill" href="#contact" style="--pill: var(--green)"><span>Contact</span></a>
  </div>
</nav>

<style>
  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 24px;
    justify-content: space-between;
    align-items: center;
    padding: clamp(20px, 2.5vw, 32px) 0;
    border-bottom: 1px solid var(--line);
  }
  .nv {
    display: inline-block;
    padding: 10px 4px;
    margin: -10px -4px;
  }
  .brand {
    display: block;
    font-weight: 700;
    font-size: clamp(24px, 2.1vw, 30px);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .role {
    margin: 4px 0 0;
    font-size: clamp(15px, 1.1vw, 16px);
    font-weight: 400;
    color: var(--muted);
  }
  /* Nav links get a coloured box on hover, like the "simple." highlight. The negative margin
     keeps the box from shifting the layout. */
  .pill span {
    display: inline-block;
    padding: 0.146em 0.25em;
    margin: -0.146em -0.25em;
    border-radius: 0.167em;
    transition: background-color 0.2s ease;
  }
  .pill:hover,
  .pill:focus-visible {
    color: var(--ink);
  }
  .pill:hover span,
  .pill:focus-visible span {
    background-color: var(--pill);
  }
  @media (prefers-reduced-motion: reduce) {
    .pill span {
      transition: none;
    }
  }
  .links {
    display: flex;
    gap: clamp(16px, 3vw, 40px);
    font-size: clamp(15px, 1.1vw, 16px);
    font-weight: 500;
  }
</style>
